{
  "format": "cleartv-theme",
  "version": 2,
  "id": "oled",
  "name": "OLED High Contrast",
  "colors": {
    "background": "#000000",
    "backgroundDeep": "#000000",
    "panel": "#0A0A0A",
    "surface": "#1A1A1A",
    "line": "#5A5A5A",
    "text": "#FFFFFF",
    "textMuted": "#E0E0E0",
    "textSoft": "#B0B0B0",
    "accent": "#FFD400",
    "good": "#4CE08A",
    "bad": "#FF6B6B",
    "warn": "#FFD400"
  },
  "font": {
    "display": "sans-medium",
    "body": "sans-medium",
    "scale": 1.1
  },
  "shape": {
    "radius": 4,
    "focusRing": 5,
    "focusScale": 1.05,
    "cardOpacity": 100
  },
  "tiles": {
    "size": 1
  },
  "layout": {
    "rowSpacing": 16,
    "header": "full",
    "backdrop": "plain",
    "homeRows": [
      "services",
      "continue",
      "watchlist"
    ],
    "serviceAccents": false
  },
  "screens": {
    "service": {
      "nav": "tabs"
    },
    "home": {
      "defaultFocus": "apps",
      "root": {
        "type": "overlay",
        "width": "fill",
        "height": "fill",
        "children": [
          {
            "type": "backdrop",
            "source": "focused",
            "fallback": "brand",
            "scrim": {
              "bottom": 1,
              "left": 0.7
            }
          },
          {
            "type": "stack",
            "direction": "column",
            "scroll": true,
            "width": "fill",
            "height": "fill",
            "padding": [
              48,
              40,
              48,
              0
            ],
            "children": [
              {
                "type": "hero",
                "width": 620,
                "height": 132,
                "titleSize": 28,
                "titleLines": 2,
                "descLines": 1
              },
              {
                "type": "row",
                "id": "shelf",
                "data": "focused-service",
                "margin": [
                  0,
                  6,
                  0,
                  0
                ],
                "gap": 28,
                "card": {
                  "width": 228,
                  "radius": 10,
                  "label": "focused",
                  "fill": "deep"
                },
                "effect": {
                  "scale": 1.08,
                  "ring": true
                },
                "focus": {
                  "down": "apps"
                }
              },
              {
                "type": "dock",
                "id": "apps",
                "items": [
                  "services",
                  "search",
                  "themes",
                  "settings"
                ],
                "gap": 20,
                "margin": [
                  0,
                  10,
                  0,
                  0
                ],
                "card": {
                  "width": 104,
                  "radius": 10
                },
                "effect": {
                  "scale": 1.08,
                  "ring": true
                },
                "focus": {
                  "up": "shelf"
                }
              },
              {
                "type": "text",
                "bind": "status",
                "style": "kicker",
                "size": 10,
                "color": "soft",
                "width": "fill",
                "margin": [
                  0,
                  16,
                  0,
                  40
                ]
              }
            ]
          },
          {
            "type": "clock",
            "gravity": "top-end",
            "size": 18,
            "margin": [
              0,
              27,
              48,
              0
            ]
          }
        ]
      }
    }
  }
}
