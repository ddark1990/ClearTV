{
  "format": "cleartv-theme",
  "version": 2,
  "id": "billboard",
  "name": "Billboard",
  "colors": {
    "background": "#141414",
    "backgroundDeep": "#0A0A0A",
    "panel": "#1F1F1F",
    "surface": "#333333",
    "line": "#404040",
    "text": "#FFFFFF",
    "textMuted": "#D2D2D2",
    "textSoft": "#A3A3A3",
    "accent": "#E50914",
    "good": "#46D369",
    "bad": "#FF6B6B",
    "warn": "#F5C518"
  },
  "font": {
    "display": "condensed",
    "body": "sans",
    "scale": 1.0
  },
  "shape": {
    "radius": 4,
    "focusRing": 3,
    "focusScale": 1.08,
    "cardOpacity": 90
  },
  "tiles": {
    "size": 1
  },
  "layout": {
    "rowSpacing": 28,
    "header": "compact",
    "backdrop": "gradient",
    "homeRows": [
      "services",
      "continue",
      "watchlist"
    ],
    "serviceAccents": true
  },
  "screens": {
    "service": {
      "nav": "tabs"
    },
    "home": {
      "defaultFocus": "cont",
      "root": {
        "type": "overlay",
        "width": "fill",
        "height": "fill",
        "children": [
          {
            "type": "backdrop",
            "source": "focused",
            "fallback": "gradient",
            "scrim": {
              "bottom": 1,
              "left": 0.85,
              "top": 0.5
            }
          },
          {
            "type": "stack",
            "direction": "column",
            "scroll": true,
            "width": "fill",
            "height": "fill",
            "padding": [
              48,
              24,
              48,
              32
            ],
            "children": [
              {
                "type": "stack",
                "direction": "row",
                "align": "center",
                "width": "fill",
                "children": [
                  {
                    "type": "logo",
                    "size": 20,
                    "color": "accent"
                  },
                  {
                    "type": "tabs",
                    "id": "top",
                    "items": [
                      "search",
                      "services",
                      "themes",
                      "settings"
                    ],
                    "gap": 0,
                    "size": 13,
                    "margin": [
                      12,
                      0,
                      0,
                      0
                    ],
                    "focus": {
                      "down": "cont"
                    }
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "clock",
                    "size": 14,
                    "margin": [
                      8,
                      0,
                      0,
                      0
                    ]
                  }
                ]
              },
              {
                "type": "hero",
                "width": 560,
                "height": 150,
                "margin": [
                  0,
                  56,
                  0,
                  0
                ],
                "titleSize": 36,
                "titleLines": 2,
                "descLines": 2
              },
              {
                "type": "row",
                "data": "continue",
                "title": "Continue watching",
                "margin": [
                  0,
                  14,
                  0,
                  0
                ],
                "gap": 18,
                "card": {
                  "width": 220,
                  "radius": 4,
                  "label": "focused"
                },
                "effect": {
                  "scale": 1.08,
                  "ring": false
                },
                "id": "cont",
                "focus": {
                  "up": "top"
                }
              },
              {
                "type": "row",
                "data": "service:youtube",
                "title": "YouTube",
                "margin": [
                  0,
                  14,
                  0,
                  0
                ],
                "gap": 18,
                "card": {
                  "width": 220,
                  "radius": 4,
                  "label": "focused"
                },
                "effect": {
                  "scale": 1.08,
                  "ring": false
                }
              },
              {
                "type": "row",
                "data": "service:prime",
                "title": "Prime Video",
                "margin": [
                  0,
                  14,
                  0,
                  0
                ],
                "gap": 18,
                "card": {
                  "width": 220,
                  "radius": 4,
                  "label": "focused"
                },
                "effect": {
                  "scale": 1.08,
                  "ring": false
                }
              },
              {
                "type": "row",
                "data": "service:tubi",
                "title": "Tubi",
                "margin": [
                  0,
                  14,
                  0,
                  0
                ],
                "gap": 18,
                "card": {
                  "width": 220,
                  "radius": 4,
                  "label": "focused"
                },
                "effect": {
                  "scale": 1.08,
                  "ring": false
                }
              },
              {
                "type": "row",
                "data": "service:pluto",
                "title": "Pluto TV",
                "margin": [
                  0,
                  14,
                  0,
                  0
                ],
                "gap": 18,
                "card": {
                  "width": 220,
                  "radius": 4,
                  "label": "focused"
                },
                "effect": {
                  "scale": 1.08,
                  "ring": false
                }
              },
              {
                "type": "row",
                "data": "watchlist",
                "title": "My list",
                "margin": [
                  0,
                  14,
                  0,
                  0
                ],
                "gap": 18,
                "card": {
                  "width": 220,
                  "radius": 4,
                  "label": "focused"
                },
                "effect": {
                  "scale": 1.08,
                  "ring": false
                }
              },
              {
                "type": "text",
                "bind": "status",
                "style": "kicker",
                "size": 10,
                "color": "soft",
                "width": "fill",
                "margin": [
                  0,
                  16,
                  0,
                  0
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
