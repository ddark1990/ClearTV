{
  "format": "cleartv-theme",
  "version": 2,
  "id": "apple",
  "name": "Apple",
  "author": "ClearTV examples",
  "colors": {
    "background": "#111113",
    "backgroundDeep": "#08080A",
    "panel": "#2C2C30",
    "surface": "#3D3D42",
    "line": "#3A3A3E",
    "text": "#F5F5F7",
    "textMuted": "#C7C7CC",
    "textSoft": "#8E8E93",
    "accent": "#E5E5EA",
    "good": "#32D74B",
    "bad": "#FF6961",
    "warn": "#FFD60A"
  },
  "font": {
    "display": "sans-medium",
    "body": "sans",
    "scale": 1.05
  },
  "shape": {
    "radius": 18,
    "focusRing": 2,
    "focusScale": 1.1,
    "cardOpacity": 70
  },
  "tiles": {
    "size": 1
  },
  "layout": {
    "rowSpacing": 32,
    "header": "minimal",
    "backdrop": "gradient",
    "servicesStyle": "hero",
    "homeRows": [
      "services",
      "continue",
      "watchlist"
    ],
    "serviceAccents": false
  },
  "screens": {
    "service": {
      "nav": "tabs"
    },
    "home": {
      "defaultFocus": "apps",
      "root": {
        "type": "overlay",
        "width": "fill",
        "height": "fill",
        "children": [
          {
            "type": "backdrop",
            "source": "focused",
            "fallback": "brand",
            "scrim": {
              "bottom": 1,
              "left": 0.7
            }
          },
          {
            "type": "stack",
            "direction": "column",
            "scroll": true,
            "width": "fill",
            "height": "fill",
            "padding": [
              48,
              40,
              48,
              0
            ],
            "children": [
              {
                "type": "hero",
                "width": 620,
                "height": 118,
                "titleSize": 28,
                "titleLines": 2,
                "descLines": 1
              },
              {
                "type": "row",
                "id": "shelf",
                "data": "focused-service",
                "margin": [
                  0,
                  6,
                  0,
                  0
                ],
                "gap": 28,
                "card": {
                  "width": 228,
                  "radius": 10,
                  "label": "focused",
                  "fill": "deep"
                },
                "effect": {
                  "scale": 1.1,
                  "ring": false
                },
                "focus": {
                  "down": "apps"
                }
              },
              {
                "type": "dock",
                "id": "apps",
                "items": [
                  "services",
                  "search"
                ],
                "gap": 28,
                "margin": [
                  0,
                  10,
                  0,
                  0
                ],
                "card": {
                  "width": 150,
                  "radius": 10
                },
                "effect": {
                  "scale": 1.1,
                  "ring": false
                },
                "focus": {
                  "up": "shelf",
                  "down": "tools"
                }
              },
              {
                "type": "dock",
                "id": "tools",
                "items": [
                  "themes",
                  "settings"
                ],
                "gap": 28,
                "margin": [
                  0,
                  22,
                  0,
                  0
                ],
                "card": {
                  "width": 150,
                  "radius": 10
                },
                "effect": {
                  "scale": 1.1,
                  "ring": false
                },
                "focus": {
                  "up": "apps"
                }
              },
              {
                "type": "text",
                "bind": "status",
                "style": "kicker",
                "size": 10,
                "color": "soft",
                "width": "fill",
                "margin": [
                  0,
                  16,
                  0,
                  40
                ]
              }
            ]
          },
          {
            "type": "clock",
            "gravity": "top-end",
            "size": 18,
            "margin": [
              0,
              27,
              48,
              0
            ]
          }
        ]
      }
    }
  }
}
